# Remote API (production — leave empty to use dev proxy to http://127.0.0.1:3847)
# VITE_API_BASE_URL=https://your-server:3847/api
# Optional: WebSocket URL (dev defaults to ws://127.0.0.1:3847/api/ws when no server URL is saved)
# VITE_API_WS_URL=ws://127.0.0.1:3847/api/ws

# Map tiles from xam.nu CDN (dayz.xam.nu paths return HTML — use static.xam.nu)
VITE_MAP_TILES=https://static.xam.nu/dayz/maps/chernarusplus/1.27/topographic/{z}/{x}/{y}.webp
VITE_MAP_MAX_ZOOM=7
VITE_MAP_SIZE=15360
VITE_MAP_NAME=chernarusplus

# Optional: static image instead of tiles
# VITE_MAP_IMAGE=/maps/chernarus.jpg
